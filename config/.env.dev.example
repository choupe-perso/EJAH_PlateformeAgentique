# Environnement DEV - copier vers .env.local a la racine du worktree DEV
# Ne jamais renseigner de valeur reelle dans un fichier suivi par git.

NODE_ENV=development
APP_ENV=dev
PORT=3000

# Base de donnees PostgreSQL 18 locale - une base dediee par environnement
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=pf_ejah_db_dev
DATABASE_USER=
DATABASE_PASSWORD=

# Cles d'authentification / API tierces (a completer au fur et a mesure des besoins reels)
# AUCUNE cle ne doit avoir de valeur dans ce fichier exemple suivi par git.

# Ollama local (agent Taches - redaction assistee). Ni l'un ni l'autre n'est
# un secret : valeurs par defaut deja codees si omises (localhost:11434,
# qwen3:8b).
OLLAMA_HOST=
OLLAMA_MODEL=

# Passphrase du vault local de l'agent Anonymisation (python/anonymizer/) -
# jamais saisie dans la plateforme, jamais transmise en HTTP. Perdre cette
# valeur rend le vault existant illisible par conception (voir vault.py).
ANONYMIZER_PASSPHRASE=

# Nom affiche dans le header de l'app (logo). Pas un secret - "EJAH" reste
# le nom par defaut si cette cle est absente.
APP_DISPLAY_NAME=

# Agent Veille - Gemini (palier gratuit uniquement, EXG-001). Optionnel :
# absent = moteur Gemini simplement indisponible pour la veille, sans
# bloquer le reste de la plateforme.
GEMINI_API_KEY=
GEMINI_MODEL=

# Agent Veille - jeton partage pour le declenchement externe de la veille
# (equivalent Airflow, POST /api/veille/run/externe, en-tete
# "Authorization: Bearer <valeur>"). Valeur locale a generer soi-meme,
# jamais transmise en dehors de cette machine.
VEILLE_RUN_TOKEN=
