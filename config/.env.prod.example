# Environnement PROD - copier vers .env.local a la racine du worktree PROD
# Ne jamais renseigner de valeur reelle dans un fichier suivi par git.

NODE_ENV=production
APP_ENV=prod
PORT=3002

# Base de donnees PostgreSQL 18 locale - une base dediee par environnement
DATABASE_URL=
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=pf_ejah_db
DATABASE_USER=
DATABASE_PASSWORD=

# Cles d'authentification / API tierces (a completer au fur et a mesure des besoins reels)
# AUCUNE cle ne doit avoir de valeur dans ce fichier exemple suivi par git.
